QMainWindow, QWidget {
    background-color: #ffffff;
    color: #000000;
}

QFrame {
    border: 1px solid #000000;
    background-color: #ffffff;
}

QLabel {
    font-size: 20px;
    font-weight: bold;
    padding: 10px;
    color: #000000;
}

QTextEdit {
    font-size: 20px;
    border: 1px solid #000000;
    background-color: #ffffff;
    padding: 8px;
}

QTextEdit:focus {
    border: 2px solid #000000;
}

QListView {
    font-size: 20px;
    border: 1px solid #000000;
    background-color: #ffffff;
    outline: none;
}

QListView::item {
    padding: 8px;
    border-bottom: 1px solid #dddddd;
}

QListView::item:selected {
    background-color: #e0e0e0;
    color: #000000;
}

QListView::item:hover {
    background-color: #f0f0f0;
}

QPushButton {
    font-size: 20px;
    min-width: 100px;
    min-height: 50px;
    background-color: #ffffff;
    color: #000000;
    border: 2px solid #000000;
    padding: 5px 15px;
}

QPushButton:hover {
    background-color: #f0f0f0;
    border: 3px solid #000000;
}

QPushButton:pressed {
    background-color: #cccccc;
    border: 2px solid #000000;
}

QPushButton:default {
    border: 4px solid #000000;
    font-weight: bold;
}